# Copy to .env and fill in. The .env never goes into Git.
# The README explains each variable and where to find it.

# Connection to the Railway Postgres: the DATABASE_PUBLIC_URL (Postgres → Variables)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contas_souto

# Auth.js (next-auth v4)
# Public address of the app, no trailing slash
NEXTAUTH_URL=http://localhost:3000
# Secret that signs the session cookie (see README: "Generate secrets")
NEXTAUTH_SECRET=

# Google login (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails allowed to sign in, comma-separated
ALLOWED_EMAILS=ana@example.com,rui@example.com

# Wallet API token (Premium plan): https://web.budgetbakers.com/settings/apiTokens
WALLET_API_TOKEN=

# Fixed monthly salaries for the forecast: "Name:amount", comma-separated (dot as decimal separator).
# Empty: salaries come from the Wallet transactions. (The old name SALARIOS_FIXOS still works.)
FIXED_SALARIES=Ana:1500,Rui:1500

# Secret shared between the app and the GitHub Actions cron (see README: "Generate secrets")
CRON_SECRET=

# Only for "npm run cron:sync" locally: address of the app to call
# APP_URL=http://localhost:3000
