# Copia para .env e preenche. O .env nunca vai para o Git.
# O README explica cada variável e onde a encontrar.

# Ligação ao Postgres (no Railway, usa a referência ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contas_souto

# Auth.js (next-auth v4)
# Endereço público da app, sem barra no fim
NEXTAUTH_URL=http://localhost:3000
# Segredo para assinar o cookie da sessão (ver README: "Gerar segredos")
NEXTAUTH_SECRET=

# Login Google (Google Cloud Console > APIs e serviços > Credenciais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails que podem entrar, separados por vírgula
ALLOWED_EMAILS=rui@example.com,ana@example.com

# Token da API do Wallet (plano Premium): https://web.budgetbakers.com/settings/apiTokens
WALLET_API_TOKEN=

# Segredo partilhado entre a app e o serviço cron (ver README: "Gerar segredos")
CRON_SECRET=

# Só no serviço cron: endereço da app que o cron chama
# APP_URL=https://contas-souto.up.railway.app
